---
const { src, alt, class: className = '', loading = 'lazy', fetchpriority, sizes = '(max-width: 760px) 92vw, 33vw' } = Astro.props;
const sourceWidths: Record<string, number> = {
  '/assets/lily6.webp': 1080,
  '/assets/lily9.webp': 810,
  '/pictures/work1.webp': 606,
  '/pictures/work2.webp': 611,
  '/pictures/work3.webp': 587,
  '/pictures/work4.webp': 559,
  '/pictures/work5.webp': 611,
  '/pictures/work6.webp': 590,
};
const width = sourceWidths[src];
const variants = width ? [160, 240, 320, 400, 480, 640, 800, 1080].filter((candidate) => candidate < width) : [];
const srcset = width
  ? [...variants.map((candidate) => `${src.replace(/\.webp$/, `-${candidate}w.webp`)} ${candidate}w`), `${src} ${width}w`].join(', ')
  : undefined;
---
<img class={className} src={src} srcset={srcset} sizes={sizes} alt={alt} loading={loading} fetchpriority={fetchpriority} decoding="async" />
