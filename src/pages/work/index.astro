---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import { Icon } from 'astro-icon/components';
const stories = [
 {title:'A portrait in red',kind:'Portrait story',place:'Portraits',image:'/pictures/work6.webp',alt:'Portrait in a red gele and white blouse',text:'A composed portrait with rich colour, beautiful fabric and a quiet, confident gaze.'},
 {title:'Grace in green',kind:'Portrait story',place:'Portraits',image:'/pictures/work2.webp',alt:'Woman in a mint green traditional outfit',text:'A little stillness lets the details, colour and expression take the frame.'},
 {title:'The celebration keeps moving',kind:'Event film',place:'Celebrations',image:'/pictures/work1.webp',alt:'Guests dancing under red and purple event lights',text:'Live music, vivid lights and the joyful energy of a room coming together.'},
 {title:'A moment in traditional style',kind:'Portrait story',place:'Portraits',image:'/pictures/work4.webp',alt:'Woman in a red traditional outfit and gele',text:'A portrait that holds onto the bold colour and character of the occasion.'},
 {title:'Every detail, remembered',kind:'Event portrait',place:'Celebrations',image:'/pictures/work5.webp',alt:'Woman in a green and black traditional outfit',text:'A bright, personal frame from a day full of colour and familiar faces.'},
 {title:'A celebration in full colour',kind:'Event story',place:'Celebrations',image:'/pictures/work3.webp',alt:'Guests at a celebration in colourful traditional clothing',text:'A lively scene, photographed as it unfolded, with all the colour left in.'}
];
const reels = [
 {title:'The walk to forever',kind:'Wedding highlight',src:'/reels/reel1.mp4',poster:'/assets/reel-1-poster.webp',alt:'Wedding highlight reel featuring a bride in a white gown'},
 {title:'All the little details',kind:'Bridal portrait',src:'/reels/reel2.mp4',poster:'/assets/reel-2-poster.webp',alt:'Bridal portrait reel with a bouquet'},
 {title:'Getting ready together',kind:'Behind the scenes',src:'/reels/reel3.mp4',poster:'/assets/reel-3-poster.webp',alt:'Behind-the-scenes makeup preparation reel'},
 {title:'A night in good company',kind:'Celebration',src:'/reels/reel4.mp4',poster:'/assets/reel-4-poster.webp',alt:'Friends sharing a lively evening celebration'}
];
---
<Layout title="Selected photography & reels — Monumental Reels" description="Portraits, celebrations and short films captured by Lilly Oluwatomi Oluyemi. Browse her photography and mobile reels." active="Selected work">
<section class="work-hero" aria-labelledby="work-title"><div class="work-hero-copy"><h1 id="work-title">People,<br />presence, <i>feeling.</i></h1><p>Some stories arrive dressed in colour. Others happen in a glance, a laugh, a room coming alive. Here are a few Lilly has held onto.</p><a class="button-primary" href="/about/#booking">Make your story <Icon name="ph:arrow-up-right" size={15} /></a><span class="work-hero-note">A growing collection of photographs and films</span></div><div class="work-hero-images" aria-label="A selection of Lilly’s portrait photography"><div class="work-hero-main"><Photo src="/pictures/work6.webp" alt="Portrait in a red gele and white blouse" loading="eager" fetchpriority="high" /><span>Colour, presence, personality</span></div><div class="work-hero-side"><Photo src="/pictures/work2.webp" alt="Woman in a mint green traditional outfit" loading="eager" /><Photo src="/pictures/work4.webp" alt="Woman in a red traditional outfit" loading="eager" /></div><div class="work-photo-note"><Icon name="ph:camera" size={16} /><span>THROUGH LILLY’S EYES</span></div></div></section>
<section class="gallery" aria-label="Selected photographs">{stories.map((story, i)=><article class:list={['story','reveal',i%2===1?'offset':'']}><div class="story-image"><Photo src={story.image} alt={story.alt} /><span>{story.kind}</span></div><div class="story-copy"><p class="story-place">{story.place}</p><h2>{story.title}</h2><p>{story.text}</p><a href="/about/#booking">Make something like this <Icon name="ph:arrow-up-right" size={14} /></a></div></article>)}</section>
<section class="reel-section" aria-labelledby="reel-title"><div class="reel-heading"><div><p class="eyebrow">SHORT FILMS, ON REPEAT</p><h2 id="reel-title">Little films,<br /><i>made to feel.</i></h2></div><p>Reels play quietly as you browse. Tap any clip for sound or full playback controls.</p></div><div class="reel-grid">{reels.map((reel)=><article class="reel-card"><video data-autoplay-reel muted loop controls preload="none" playsinline poster={reel.poster} aria-label={reel.alt}><source src={reel.src} type="video/mp4" /></video><div class="reel-caption"><p>{reel.kind}</p><h3>{reel.title}</h3></div></article>)}</div></section>
<section class="end-cta"><h2>Your moment could<br />be the next <i>story.</i></h2><a class="button-primary" href="/about/#booking">Let’s talk about it <Icon name="ph:arrow-up-right" size={15} /></a></section>
</Layout>
<style>
.work-hero{max-width:1550px;margin:auto;padding:clamp(47px,6vw,80px) clamp(1.2rem,7vw,7rem) clamp(54px,6vw,78px);display:grid;grid-template-columns:minmax(300px,.77fr) minmax(0,1.23fr);align-items:center;gap:clamp(40px,7vw,105px);text-align:left}.work-hero-copy{max-width:500px}.work-hero h1{font:600 clamp(4rem,7.3vw,7.1rem)/.88 var(--display);letter-spacing:-.085em;margin:23px 0 19px}.work-hero h1 i{font-style:italic;color:var(--wine-2)}.work-hero-copy>p:not(.hero-location){max-width:410px;color:var(--muted);font-size:13px;line-height:1.85}.work-hero-copy .button-primary{margin-top:15px;border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 18%,transparent)}.work-hero-note{display:block;margin-top:38px;padding-top:13px;border-top:1px solid var(--line);color:var(--muted);font-size:8px;letter-spacing:.14em}.work-hero-images{position:relative;height:clamp(390px,43vw,560px);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,.72fr);gap:11px;min-width:0}.work-hero-main,.work-hero-side{position:relative;min-width:0;overflow:hidden;box-shadow:var(--shadow)}.work-hero-main{margin:0 0 24px}.work-hero-main :global(img),.work-hero-side :global(img){width:100%;height:100%;display:block;object-fit:cover}.work-hero-main :global(img){object-position:center 25%}.work-hero-main::after{content:"";position:absolute;inset:50% 0 0;background:linear-gradient(0deg,#2419179c,transparent)}.work-hero-main span{position:absolute;z-index:1;bottom:14px;left:15px;color:white;font-size:8px;letter-spacing:.12em}.work-hero-main span i{font-style:normal;color:#eac4ca;padding-left:7px}.work-hero-side{display:grid;grid-template-rows:1fr 1fr;gap:11px;margin:22px 0 0}.work-photo-note{position:absolute;right:14px;top:14px;display:flex;align-items:center;gap:9px;padding:10px 13px;border:1px solid var(--glass-border);border-radius:12px;color:var(--ink);background:var(--glass-strong);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 var(--glass-border);font-size:8px;font-weight:700;letter-spacing:.08em}.work-photo-note svg{color:var(--wine)}.work-photo-note small{color:var(--muted)}.work-hero::after{display:none}
@media(max-width:850px){.work-hero{grid-template-columns:minmax(260px,.82fr) minmax(0,1.18fr);gap:30px;padding-left:1.5rem;padding-right:1.5rem}.work-hero h1{font-size:clamp(3.6rem,8vw,5.8rem)}.work-hero-images{height:420px}}
@media(max-width:650px){.work-hero{display:flex;flex-direction:column;align-items:stretch;gap:23px;padding:43px 1.15rem 40px}.work-hero h1{font-size:clamp(3.65rem,15.7vw,5.3rem);margin:20px 0 15px}.work-hero-copy>p:not(.hero-location){font-size:12px}.work-hero-note{margin-top:24px}.work-hero-images{height:clamp(360px,105vw,470px);grid-template-columns:minmax(0,1.18fr) minmax(0,.72fr);gap:8px}.work-hero-main{margin-bottom:17px}.work-hero-side{gap:8px;margin-top:17px}.work-photo-note{top:9px;right:8px;padding:8px 9px;font-size:7px}.work-hero-main span{left:10px;bottom:11px;font-size:7px}}
</style>

<style>
.eyebrow{font-size:9px;letter-spacing:.2em;font-weight:700;color:var(--wine)}.work-hero{text-align:center;padding:90px 1.2rem 75px}.work-hero h1,.end-cta h2{font:600 clamp(3.4rem,8vw,7rem)/.98 var(--display);letter-spacing:-.09em;margin:22px 0}.work-hero h1 i,.end-cta h2 i{font-style:normal;color:var(--wine-2)}.work-hero>p:last-child{font-size:14px;line-height:1.8;color:var(--muted);max-width:430px;margin:0 auto}.gallery{max-width:1250px;margin:0 auto;padding:0 clamp(1.2rem,7vw,7rem) 70px;display:grid;grid-template-columns:1fr 1fr;column-gap:8%;row-gap:55px}.story.offset{margin-top:90px}.story-image{height:420px;position:relative;overflow:hidden;background:var(--warm)}.story:nth-child(3n + 2) .story-image{height:350px}.story-image :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.82);transition:transform .7s cubic-bezier(.2,0,0,1)}.story:hover img{transform:scale(1.03)}.story-image span{position:absolute;bottom:15px;left:15px;padding:9px 13px;background:var(--surface);font-size:10px}.story-copy{padding:18px 4px}.story-place{font-size:9px;color:var(--wine);letter-spacing:.13em;text-transform:uppercase;margin:0 0 10px}.story-copy h2{font:600 24px var(--display);letter-spacing:-.05em;margin:0}.story-copy>p:not(.story-place){font-size:12px;line-height:1.8;color:var(--muted);max-width:390px}.story-copy a{display:inline-block;margin-top:8px;border-bottom:1px solid var(--line);padding:6px 0;font-weight:600;font-size:11px}.story-copy a svg{color:var(--wine)}.end-cta{text-align:center;padding:70px 1rem 100px;background:var(--warm)}.end-cta h2{font-size:clamp(2.8rem,6vw,5rem)}.button-primary{display:inline-flex;align-items:center;gap:18px;padding:15px 19px;background:var(--action);color:var(--on-action);font-size:12px;font-weight:600}.reveal{opacity:1}.story-image :global(img){transition:transform .3s cubic-bezier(.2,0,0,1)}@media(max-width:700px){.work-hero{padding:65px 1.2rem 55px}.gallery{grid-template-columns:1fr;gap:25px;padding-bottom:45px}.story.offset{margin-top:0}.story-image,.story:nth-child(3n + 2) .story-image{height:400px}.story-copy h2{font-size:22px}}
</style>
<style>
.work-hero{max-width:1500px;margin:0 auto;padding:clamp(45px,6vw,76px) clamp(1.2rem,7vw,7rem) 58px;display:grid;grid-template-columns:minmax(300px,.83fr) minmax(0,1.17fr);column-gap:clamp(36px,6vw,90px);align-items:center;text-align:left}.work-hero-copy{max-width:500px}.work-hero h1{font:600 clamp(4.1rem,7.1vw,7rem)/.88 var(--display);letter-spacing:-.085em;margin:0 0 24px}.work-hero h1 i{font-style:italic;color:var(--wine-2)}.work-hero-copy>p:not(.hero-location){font-size:15px;line-height:1.8;color:var(--muted);max-width:420px}.work-hero-copy .button-primary{margin-top:17px;border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 18%,transparent)}.work-hero-note{display:block;max-width:370px;margin-top:32px;padding-top:13px;border-top:1px solid var(--line);color:var(--muted);font-size:12px}.work-hero-images{position:relative;height:clamp(420px,43vw,570px);display:grid;grid-template-columns:minmax(0,1.25fr) minmax(0,.72fr);gap:14px;min-width:0}.work-hero-main,.work-hero-side{position:relative;min-width:0;overflow:hidden;border:1px solid var(--glass-border);border-radius:18px;box-shadow:var(--shadow)}.work-hero-main{margin:0 0 25px}.work-hero-main :global(img),.work-hero-side :global(img){width:100%;height:100%;display:block;object-fit:cover}.work-hero-main :global(img){object-position:center 25%}.work-hero-main::after{content:"";position:absolute;inset:50% 0 0;background:linear-gradient(0deg,#2419179c,transparent)}.work-hero-main span{position:absolute;z-index:1;bottom:17px;left:18px;color:white;font-size:12px}.work-hero-side{display:grid;grid-template-rows:1fr 1fr;gap:14px;margin:25px 0 0}.work-photo-note{position:absolute;right:18px;top:18px;display:flex;align-items:center;gap:9px;padding:11px 15px;border:1px solid var(--glass-border);border-radius:999px;color:var(--ink);background:var(--glass-strong);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px);box-shadow:inset 0 1px 0 var(--glass-border);font-size:10px;font-weight:600}.work-photo-note svg{color:var(--wine)}.work-hero::after{display:none}
.gallery{max-width:1250px;margin:0 auto;padding:0 clamp(1.2rem,7vw,7rem) 70px;display:grid;grid-template-columns:1fr 1fr;column-gap:8%;row-gap:55px}.story.offset{margin-top:90px}.story-image{height:420px;position:relative;overflow:hidden;background:var(--warm)}.story:nth-child(3n + 2) .story-image{height:350px}.story-image :global(img){width:100%;height:100%;object-fit:cover;filter:saturate(.82);transition:transform .7s cubic-bezier(.2,0,0,1)}.story:hover img{transform:scale(1.03)}.story-image span{position:absolute;bottom:15px;left:15px;padding:9px 13px;background:var(--surface);font-size:10px}.story-copy{padding:18px 4px}.story-place{font-size:9px;color:var(--wine);letter-spacing:.13em;text-transform:uppercase;margin:0 0 10px}.story-copy h2{font:600 24px var(--display);letter-spacing:-.05em;margin:0}.story-copy>p:not(.story-place){font-size:12px;line-height:1.8;color:var(--muted);max-width:390px}.story-copy a{display:inline-flex;align-items:center;gap:6px;margin-top:8px;border-bottom:1px solid var(--line);padding:6px 0;font-weight:600;font-size:11px}.story-copy a svg{color:var(--wine)}.end-cta{text-align:center;padding:70px 1rem 100px;background:var(--warm)}.end-cta h2{font:600 clamp(2.8rem,6vw,5rem)/.98 var(--display);letter-spacing:-.09em;margin:22px 0}.end-cta h2 i{font-style:italic;color:var(--wine-2)}.button-primary{display:inline-flex;align-items:center;gap:18px;padding:15px 19px;background:var(--action);color:var(--on-action);font-size:12px;font-weight:600}.story-image{border-radius:18px;box-shadow:var(--shadow)}.story-image span{border:1px solid var(--glass-border);border-radius:999px;background:var(--glass-strong);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);box-shadow:inset 0 1px 0 var(--glass-border),0 8px 22px rgb(0 0 0 / 10%)}.story-copy a{transition:color .18s,border-color .18s,transform .18s}.story-copy a:hover{color:var(--wine);border-color:var(--wine);transform:translateX(3px)}.story:focus-within .story-image{outline:2px solid var(--accent);outline-offset:4px}.end-cta{background-image:radial-gradient(ellipse at 50% 120%,rgb(255 255 255 / 38%),transparent 62%)}.end-cta .button-primary{border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 20%,transparent);transition:transform .18s,box-shadow .18s}.end-cta .button-primary:hover{transform:translateY(-2px);box-shadow:0 12px 28px color-mix(in srgb,var(--wine) 25%,transparent)}
@media(max-width:900px){.work-hero{grid-template-columns:.9fr 1.1fr;column-gap:4vw}.work-hero h1{font-size:clamp(3.5rem,6vw,5.4rem)}.work-hero-images{height:420px;grid-template-columns:1.2fr .8fr}}
@media(max-width:700px){.work-hero{display:flex;flex-direction:column;align-items:stretch;gap:23px;padding:45px 1.2rem 39px}.work-hero h1{font-size:clamp(3.7rem,15vw,5.5rem);margin:0 0 18px}.work-hero-copy>p:not(.hero-location){font-size:13px}.work-hero-copy .button-primary{margin-top:12px}.work-hero-note{margin-top:22px}.work-hero-images{height:clamp(360px,100vw,470px);grid-template-columns:1.25fr .75fr;gap:8px}.work-hero-main{margin-bottom:18px}.work-hero-side{gap:8px;margin-top:18px}.work-photo-note{top:9px;right:8px;padding:8px 10px;font-size:8px}.work-hero-main span{left:12px;bottom:12px;font-size:10px}.gallery{grid-template-columns:1fr;gap:25px;padding-bottom:45px}.story.offset{margin-top:0}.story-image,.story:nth-child(3n + 2) .story-image{height:400px}.story-copy h2{font-size:22px}}
@media(prefers-reduced-motion:reduce){.story-image :global(img){transition:none}}
.reel-section{padding:92px clamp(1.2rem,7vw,7rem) 106px;background:var(--warm)}.reel-heading{max-width:1250px;margin:0 auto 34px;display:flex;align-items:end;justify-content:space-between;gap:40px}.reel-heading h2{font:600 clamp(2.8rem,6vw,5.6rem)/.94 var(--display);letter-spacing:-.08em;margin:16px 0 0}.reel-heading h2 i{font-style:italic;color:var(--wine-2)}.reel-heading>p{max-width:350px;margin:0 0 5px;color:var(--muted);font-size:13px;line-height:1.8}.reel-grid{max-width:1250px;margin:auto;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px}.reel-card{min-width:0}.reel-card video{display:block;width:100%;aspect-ratio:9/16;object-fit:cover;border-radius:18px;background:#1e171b;box-shadow:var(--shadow)}.reel-caption{padding:13px 2px}.reel-caption p{margin:0 0 6px;color:var(--wine);font-size:9px;letter-spacing:.12em;text-transform:uppercase}.reel-caption h3{margin:0;font:600 19px/1.2 var(--display);letter-spacing:-.03em}.reel-card video:focus-visible{outline:3px solid var(--accent);outline-offset:3px}@media(max-width:900px){.reel-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 14px}.reel-heading{align-items:start;flex-direction:column;gap:18px}.reel-heading>p{max-width:480px}}@media(max-width:700px){.reel-section{padding:66px 1.2rem 74px}.reel-grid{gap:21px 12px}.reel-card video{border-radius:14px}.reel-caption h3{font-size:17px}}
</style>
