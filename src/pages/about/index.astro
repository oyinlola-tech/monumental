  }
  .approach h2,
  .booking h2 {
    font: 600 clamp(2.8rem, 5.5vw, 5rem)/1.02 var(--display);
    letter-spacing: -0.08em;
    margin: 20px 0;
  }
  .steps article {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 15px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .steps article:first-child {
    padding-top: 0;
  }
  .steps article > span {
    font-size: 10px;
    color: var(--wine);
    padding-top: 4px;
  }
  .steps h3 {
    font: 600 17px var(--display);
    margin: 0 0 8px;
  }
  .steps p {
    font-size: 12px;
    line-height: 1.8;
    color: var(--muted);
    max-width: 430px;
    margin: 0;
  }
  .booking {
    padding: 100px clamp(1.2rem, 10vw, 10rem);
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    gap: 10vw;
  }
  .booking-copy > p:not(.eyebrow) {
    max-width: 390px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--muted);
  }
  .booking-details {
    display: grid;
    gap: 10px;
    margin-top: 32px;
    color: var(--wine);
    font-size: 11px;
  }
  .booking-details span { display: flex; align-items: center; gap: 10px; }
  .booking-details svg { color: var(--wine); }
  .booking-form {
    display: grid;
    gap: 18px;
  }
  .booking-form label {
    display: grid;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
  }
  .booking-form input,
  .booking-form textarea,
  .booking-form select {
    width: 100%;
    padding: 13px 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font:
      400 12px "DM Sans",
      sans-serif;
    border-radius: 0;
    outline: none;
  }
  .booking-form input:focus,
  .booking-form textarea:focus,
  .booking-form select:focus {
    border-color: var(--wine);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--wine) 18%, transparent);
  }
  .booking-form textarea {
    resize: vertical;
  }
  .booking-form small { font-size: 10px; color: var(--muted); }.share-status{margin:0;font-size:11px;line-height:1.6;color:var(--wine)}
  .booking-form .button-primary { width: max-content; align-items: center; }
  .booking-form .button-primary svg { margin-left: 4px; }
.booking-details a,.booking-socials a{display:flex;align-items:center;gap:10px;width:max-content;max-width:100%;color:var(--wine);font-size:11px}.booking-details a:hover,.booking-socials a:hover{text-decoration:underline;text-underline-offset:3px}.booking-socials{display:flex;flex-wrap:wrap;gap:17px;padding-top:2px}.booking-socials a{gap:7px}
  .about-photo{border-radius:4px}.about-photo :global(img){border-radius:2px}.booking-form{position:relative;padding:clamp(22px,4vw,38px);border:1px solid var(--glass-border);border-radius:24px;background:linear-gradient(145deg,var(--glass-strong),var(--glass));box-shadow:inset 0 1px 0 var(--glass-border),var(--glass-shadow);-webkit-backdrop-filter:blur(18px);backdrop-filter:blur(18px)}.booking-form label{display:grid;gap:8px;font-size:11px;font-weight:600;color:var(--ink)}.booking-form input,.booking-form select,.booking-form textarea{width:100%;border:1px solid color-mix(in srgb,var(--line) 78%,transparent);border-radius:12px;background:color-mix(in srgb,var(--paper) 66%,transparent);color:var(--ink);padding:13px 14px;font:400 12px/1.5 'DM Sans',sans-serif;outline:none;box-shadow:inset 0 1px 2px rgb(25 14 12 / 3%);transition:border-color .18s,box-shadow .18s,background .18s}.booking-form input::placeholder,.booking-form textarea::placeholder{color:var(--muted);opacity:.8}.booking-form input:focus,.booking-form select:focus,.booking-form textarea:focus{border-color:var(--wine);background:var(--surface);box-shadow:0 0 0 3px color-mix(in srgb,var(--wine) 16%,transparent)}.booking-form textarea{resize:vertical;min-height:110px}.booking-form .button-primary{width:max-content;max-width:100%;align-items:center;border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 20%,transparent);transition:transform .18s,box-shadow .18s,background .18s}.booking-form .button-primary:hover{transform:translateY(-2px);box-shadow:0 12px 28px color-mix(in srgb,var(--wine) 25%,transparent)}.booking-form small{color:var(--muted);font-size:10px;line-height:1.7}.share-status{color:var(--wine);font-size:12px;line-height:1.6;margin:0}.booking-details span{width:max-content;max-width:100%;border:1px solid var(--glass-border);border-radius:999px;padding:9px 13px;background:var(--glass);box-shadow:inset 0 1px 0 var(--glass-border);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);transition:transform .18s,color .18s}.booking-details span:hover{transform:translateX(3px);color:var(--wine)}
  @media (max-width: 760px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: 45px;
      padding-top: 60px;
    }
    .about-photo {
      width: 85%;
      justify-self: center;
    }
    .about-photo :global(img) {
      height: 400px;
    }
    .approach {
      grid-template-columns: 1fr;
      gap: 35px;
      padding: 65px 1.4rem;
    }
    .booking {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 70px 1.4rem;
    }
    .booking-form{padding:22px 18px;border-radius:20px}
    .about-copy,
  .about-photo { min-width: 0; }
  .about-copy h1 {
      font-size: 4rem;
    }
  }

.about-hero{max-width:1400px;grid-template-columns:minmax(0,1fr) minmax(0,.86fr);gap:clamp(48px,9vw,140px);padding-top:76px;padding-bottom:92px}.about-copy h1{font-size:clamp(4.2rem,8vw,7.4rem);line-height:.9;margin:24px 0 28px}.about-copy h1 i{color:var(--wine-2)}.about-copy .lead{font-size:clamp(19px,2vw,23px);line-height:1.45}.about-photo{transform:rotate(1.5deg);padding:12px;border:1px solid var(--glass-border);background:var(--glass-strong);box-shadow:0 30px 70px rgb(56 30 29 / 14%),inset 0 1px 0 var(--glass-border)}.about-photo :global(img){height:clamp(440px,48vw,600px);object-position:center 34%}.about-photo>span{padding:12px 4px 2px;font-size:8px;letter-spacing:.13em}.portrait-note{position:absolute;right:-20px;bottom:52px;display:flex;align-items:center;gap:11px;padding:13px 17px;border:1px solid rgb(255 255 255 / 45%);border-radius:16px;color:white;background:rgb(51 31 31 / 56%);-webkit-backdrop-filter:blur(18px) saturate(135%);backdrop-filter:blur(18px) saturate(135%);box-shadow:inset 0 1px 0 rgb(255 255 255 / 25%),0 10px 30px #24151530;font-size:10px;line-height:1.5}.portrait-note svg{color:#f0d6d0}.portrait-note b{font-weight:600;color:#fff}.about-copy .button-primary{border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 20%,transparent);transition:transform .18s,box-shadow .18s}.about-copy .button-primary:hover{transform:translateY(-2px);box-shadow:0 13px 30px color-mix(in srgb,var(--wine) 24%,transparent)}
@media(max-width:760px){.about-hero{grid-template-columns:1fr;gap:34px;padding-top:52px;padding-bottom:62px}.about-copy h1{font-size:clamp(4rem,15vw,5.3rem);margin:20px 0 22px}.about-photo{width:88%;padding:9px}.about-photo :global(img){height:clamp(390px,110vw,500px)}.portrait-note{right:-14px;bottom:48px;padding:10px 13px;font-size:9px}}
@media(max-width:430px){.about-photo{width:92%}.portrait-note{right:-9px;bottom:44px}}
</style>
<style>
  .bio-story {
    display: grid;
    grid-template-columns: minmax(230px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(42px, 9vw, 140px);
    padding: clamp(68px, 9vw, 126px) clamp(1.2rem, 10vw, 10rem);
    background: var(--warm);
    border-block: 1px solid color-mix(in srgb, var(--line) 62%, transparent);
  }
  .bio-story-heading { align-self: start; position: sticky; top: 110px; }
  .bio-story-heading .eyebrow { margin: 0 0 20px; }
  .bio-story-heading h2 {
    margin: 0;
    font: 600 clamp(3.2rem, 6.4vw, 6rem)/.91 var(--display);
    letter-spacing: -.075em;
  }
  .bio-story-heading h2 i { color: var(--wine-2); font-weight: 500; }
  .bio-story-copy { max-width: 730px; }
  .bio-story-copy p {
    margin: 0 0 19px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.95;
  }
  .bio-story-copy .bio-story-lead {
    color: var(--ink);
    font: 500 clamp(19px, 2.2vw, 25px)/1.55 var(--display);
  }
  .bio-story-copy strong { color: var(--ink); font-weight: 600; }
  .bio-story-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    margin-top: 7px;
    padding: 11px 0;
    color: var(--wine);
    font-size: 11px;
    font-weight: 600;
    border-bottom: 1px solid color-mix(in srgb, var(--wine) 35%, transparent);
    transition: gap .18s ease, border-color .18s ease;
  }
  .bio-story-link:hover { gap: 14px; border-color: var(--wine); }
  @media (max-width: 760px) {
    .bio-story { grid-template-columns: 1fr; gap: 28px; padding: 66px 1.4rem; }
    .bio-story-heading { position: static; }
    .bio-story-heading h2 { font-size: clamp(3.2rem, 13vw, 5rem); }
    .bio-story-copy p { font-size: 12px; }
    .bio-story-copy .bio-story-lead { font-size: 20px; }
  }
</style>
<script>
const form=document.querySelector<HTMLFormElement>("#booking-form");
form?.addEventListener("submit",(event)=>{event.preventDefault();if(!form.reportValidity())return;const data=new FormData(form);const message=[`Hi Lilly, I’d love to enquire about a shoot.`,`Name: ${data.get("name")}`,`Contact: ${data.get("contact")}`,`Project: ${data.get("project")}`,`My idea: ${data.get("message")||"I’d love to talk through the idea."}`].join("\n");const status=form.querySelector<HTMLElement>("[role=status]");if(status)status.textContent="Opening WhatsApp with your enquiry. Review it there and tap Send to deliver your message.";window.location.assign(`https://wa.me/2347069974016?text=${encodeURIComponent(message)}`);});
</script>

