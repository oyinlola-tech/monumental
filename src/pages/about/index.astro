---
import Layout from "../../layouts/Layout.astro";
import Photo from "../../components/Photo.astro";
import { Icon } from "astro-icon/components";

const lillyProfile = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Lilly Oluwatomi Oluyemi",
  jobTitle: "Mobile Photographer and Videographer",
  description:
    "Lilly Oluwatomi Oluyemi is a Lagos-based mobile photographer and videographer creating photographs, short films and edited reels through Monumental Reels.",
  homeLocation: {
    "@type": "Place",
    name: "Lagos, Nigeria",
  },
  worksFor: {
    "@type": "Organization",
    name: "Monumental Reels",
  },
  sameAs: [
    "https://www.instagram.com/monumental__reels",
    "https://www.tiktok.com/@monumental_reels",
  ],
};
---

<Layout
  title="Lilly Oluwatomi Oluyemi | Lagos Photographer & Videographer"
  description="Meet Lilly Oluwatomi Oluyemi of Monumental Reels, a Lagos-based mobile photographer and videographer creating photographs, short films and edited reels."
  active="About & book"
>
  <script type="application/ld+json" set:html={JSON.stringify(lillyProfile)} />
  <section class="about-hero">
    <div class="about-copy">
      <h1>
        I’m Lilly.<br /><i>I notice.</i>
      </h1>
      <p class="lead">I make photographs and short films that feel as real as the moment itself.</p>
      <p class="body-copy">
        I’m Lilly Oluwatomi Oluyemi, a mobile photographer and videographer
        based in Lagos. I love the unplanned laugh, the thoughtful detail, the
        way the light lands when nobody is asking it to. My phone lets me move
        easily through those moments, so the story stays honest and close.
      </p>
      <div class="about-hero-actions"><a href="#booking" class="button-primary">Tell me your idea <Icon name="ph:arrow-up-right" size={15} /></a><span>Let’s start with a conversation</span></div>
    </div>
    <div class="about-photo">
      <Photo
        src="/assets/lily9.webp"
        alt="Lilly Oluwatomi Oluyemi, mobile photographer and videographer in Lagos"
        loading="eager"
        fetchpriority="high"
      />
      <span>THE EYE BEHIND MONUMENTAL REELS</span>
      <div class="portrait-note"><Icon name="ph:device-mobile-camera" size={18} /><span>Stories made close<br /><b>Mobile-first, always personal</b></span></div>
    </div>
  </section>
  <section class="bio-story" aria-labelledby="bio-story-title">
    <div class="bio-story-heading">
      <p class="eyebrow">THE STORY BEHIND THE LENS</p>
      <h2 id="bio-story-title">Small moments.<br /><i>Big meaning.</i></h2>
    </div>
    <div class="bio-story-copy">
      <p class="bio-story-lead">Lilly Oluwatomi Oluyemi is a Lagos-based mobile photographer and videographer who believes the heart of a good story is already there—in the people, the feeling and the details you might otherwise miss.</p>
      <p>Her phone is her camera and creative toolkit: light enough to move with the moment, close enough to catch the laughter between poses, the tenderness of a glance, or the energy filling a room. She photographs people and occasions with an eye for what feels honest, then shapes moving footage into short films and edited reels that are ready to revisit and share.</p>
      <p>Through <strong>Monumental Reels</strong>, Lilly brings photography, mobile video and social-ready content together around each story. Her process is personal and unhurried: listen first, make a plan that feels like you, then give the real moments room to unfold. The result is work made to hold onto—not just a record of what happened, but a way back to how it felt.</p>
      <p>Based in Lagos, Nigeria, Lilly works with couples, creators and brands to turn an idea, gathering or everyday milestone into photographs and films with feeling.</p>
      <a class="bio-story-link" href="/work/">Explore Lilly’s selected work <Icon name="ph:arrow-up-right" size={15} /></a>
    </div>
  </section>
  <section class="approach">
    <div>
      <p class="eyebrow">HOW WE’LL MAKE IT FEEL LIKE YOU</p>
      <h2>
        Easy from the
        <br />
        <i>first hello.</i>
      </h2>
    </div>
    <div class="steps">
      <article>
        <span>01</span>
        <div>
          <h3>We talk it through</h3>
          <p>
            Tell me the moment, the mood, or the idea you’ve been sitting on.
            We’ll find a simple plan together.
          </p>
        </div>
      </article>
      <article>
        <span>02</span>
        <div>
          <h3>We make room for real life</h3>
          <p>
            I’ll guide you when you need it and let the natural moments happen
            when you don’t.
          </p>
        </div>
      </article>
      <article>
        <span>03</span>
        <div>
          <h3>You leave with a story</h3>
          <p>
            Thoughtfully edited photos and short-form video, ready to revisit
            and share.
          </p>
        </div>
      </article>
    </div>
  </section>
  <section class="booking" id="booking">
    <div class="booking-copy">
      <p class="eyebrow">LET’S TALK ABOUT YOUR IDEA</p>
      <h2>
        Tell me what
        <br />
        you’re <i>imagining.</i>
      </h2>
      <p>
        Couple session, content day, brand reel or something that doesn’t fit a
        box. I’d love to hear about it.
      </p>
      <div class="booking-details">
        <span><Icon name="ph:map-pin" size={15} /> Based in Lagos, Nigeria</span>
        <span><Icon name="ph:users-three" size={15} /> Couples, creators & brands</span>
        <a href="https://wa.me/2347069974016" target="_blank" rel="noopener noreferrer"><Icon name="ph:whatsapp-logo" size={15} /> WhatsApp · 0706 997 4016</a>
        <a href="mailto:Lilyoluyemi@gmail.com"><Icon name="ph:envelope-simple" size={15} /> Lilyoluyemi@gmail.com</a>
        <div class="booking-socials" aria-label="Follow Monumental Reels"><a href="https://www.instagram.com/monumental__reels" target="_blank" rel="noopener noreferrer"><Icon name="ph:instagram-logo" size={16} /> Instagram</a><a href="https://www.tiktok.com/@monumental_reels" target="_blank" rel="noopener noreferrer"><Icon name="ph:tiktok-logo" size={16} /> TikTok</a></div>
      </div>
    </div>
    <form class="booking-form" id="booking-form">
      <label>
        Your name
        <input
          name="name"
          autocomplete="name"
          required
          placeholder="What should I call you?"
        />
      </label>
      <label>
        Email or WhatsApp
        <input
          name="contact"
          autocomplete="email"
          required
          placeholder="How can I reach you?"
        />
      </label>
      <label>
        What are we making?
        <select name="project" required>
          <option value="" disabled selected>
            Choose what feels closest
          </option>
          <option>Couple or event story</option>
          <option>Portrait session</option>
          <option>Brand content / reels</option>
          <option>Something else</option>
        </select>
      </label>
      <label>
        A little about your idea
        <textarea
          name="message"
          rows="4"
          placeholder="The moment, the mood, the date…"
        ></textarea>
      </label>
      <button class="button-primary" type="submit">
        Continue to WhatsApp <Icon name="ph:whatsapp-logo" size={15} />
      </button>
      <small>WhatsApp will open with your enquiry prepared. Review it there and tap Send to message Lilly.</small><p class="share-status" role="status" aria-live="polite"></p>
    </form>
  </section>
</Layout>
<style>
.about-hero{max-width:1530px;margin:auto;padding:clamp(45px,6vw,78px) clamp(1.2rem,7vw,7rem) clamp(56px,7vw,90px);display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1fr);gap:clamp(42px,8vw,120px);align-items:center}.about-copy{position:relative;z-index:1;max-width:570px}.about-copy h1{font:600 clamp(4.2rem,8.2vw,7.8rem)/.87 var(--display);letter-spacing:-.09em;margin:23px 0}.about-copy h1 i{font-style:italic;color:var(--wine-2)}.about-copy .lead{max-width:475px;font:500 clamp(18px,2vw,22px)/1.5 var(--display)}.about-copy .body-copy{max-width:480px;color:var(--muted);font-size:12px;line-height:1.85;margin:17px 0 23px}.about-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:16px}.about-hero-actions .button-primary{border-radius:999px;box-shadow:0 8px 22px color-mix(in srgb,var(--wine) 20%,transparent)}.about-hero-actions>span{color:var(--muted);font-size:7px;letter-spacing:.11em}.about-photo{position:relative;width:min(100%,520px);justify-self:center;margin:0 8px 0 0;padding:11px 11px 8px;border:1px solid var(--glass-border);background:var(--glass-strong);box-shadow:0 30px 70px rgb(56 30 29 / 14%),inset 0 1px 0 var(--glass-border);transform:rotate(1.5deg)}.about-photo :global(img){width:100%;height:clamp(430px,48vw,590px);display:block;object-fit:cover;object-position:center 32%}.about-photo>span{display:block;padding:10px 4px 2px;color:var(--muted);font-size:7px;letter-spacing:.12em}.portrait-note{right:-24px;bottom:55px;padding:12px 15px;border-radius:14px}.about-hero::after{content:"";position:absolute;pointer-events:none;width:220px;height:220px;border:1px solid color-mix(in srgb,var(--wine) 18%,transparent);border-radius:50%;right:2vw;top:9vw;z-index:-1}
@media(max-width:850px){.about-hero{grid-template-columns:minmax(0,.9fr) minmax(0,1fr);gap:35px;padding-left:1.5rem;padding-right:1.5rem}.about-copy h1{font-size:clamp(3.8rem,8vw,6rem)}.about-photo :global(img){height:clamp(400px,55vw,520px)}}
@media(max-width:650px){.about-hero{display:flex;flex-direction:column;align-items:stretch;gap:22px;padding:42px 1.15rem 55px}.about-copy h1{font-size:clamp(3.8rem,16vw,5.4rem);margin:19px 0}.about-copy .lead{font-size:19px}.about-copy .body-copy{font-size:11px;margin:13px 0 18px}.about-hero-actions{gap:12px}.about-hero-actions>span{font-size:6px}.about-photo{width:87%;margin:7px 16px 0 auto;padding:8px}.about-photo :global(img){height:clamp(370px,110vw,490px)}.about-photo>span{font-size:6px}.portrait-note{right:-18px;bottom:45px;padding:10px 12px;font-size:8px}.about-hero::after{width:150px;height:150px;right:4vw;top:auto;bottom:12vw}}
</style>

<style>
  .eyebrow {
    font-size: 9px;
    letter-spacing: 0.2em;
    font-weight: 700;
    color: var(--wine);
  }
  .about-hero {
    max-width: 1250px;
    margin: auto;
    padding: 75px clamp(1.2rem, 8vw, 8rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: 10vw;
    align-items: center;
  }
  .about-copy,
  .about-photo { min-width: 0; }
  .about-copy h1 {
    font: 600 clamp(4rem, 8vw, 7rem)/1 var(--display);
    letter-spacing: -0.09em;
    margin: 24px 0;
  }
  .about-copy h1 i,
  .approach h2 i,
  .booking h2 i {
    font-style: normal;
    color: var(--wine-2);
  }
  .lead {
    font: 500 20px/1.55 var(--display);
    max-width: 480px;
  }
  .body-copy {
    font-size: 13px;
    line-height: 1.9;
    color: var(--muted);
    max-width: 480px;
    margin: 22px 0 28px;
  }
  .button-primary {
    display: inline-flex;
    gap: 18px;
    padding: 15px 19px;
    background: var(--action);
    color: var(--on-action);
    font-size: 12px;
    font-weight: 600;
    border: 0;
    cursor: pointer;
  }
  .about-photo {
    position: relative;
    padding: 10px;
    background: var(--surface);
    box-shadow: var(--shadow);
    transform: rotate(2deg);
  }
  .about-photo :global(img) {
    width: 100%;
    height: 430px;
    object-fit: cover;
    filter: saturate(0.94);
    object-position: center 36%;
  }
  .about-photo span {
    display: block;
