---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import { Icon } from 'astro-icon/components';
const works = [
 { title: 'A portrait in red', kind: 'Portrait story', image: '/pictures/work6.webp', alt: 'Portrait in a red gele and white blouse' },
 { title: 'Grace in green', kind: 'Portrait story', image: '/pictures/work2.webp', alt: 'Portrait in a green traditional outfit' },
 { title: 'A night in full colour', kind: 'Celebration', image: '/pictures/work1.webp', alt: 'Guests celebrating under colourful event lights' }
];
const reels = [
 { title: 'The walk to forever', kind: 'Wedding highlight', src: '/reels/reel1.mp4', poster: '/assets/reel-1-poster.webp', alt: 'Wedding highlight reel featuring a bride in a white gown' },
 { title: 'All the little details', kind: 'Bridal portrait', src: '/reels/reel2.mp4', poster: '/assets/reel-2-poster.webp', alt: 'Bridal portrait reel with a bouquet' },
 { title: 'Getting ready together', kind: 'Behind the scenes', src: '/reels/reel3.mp4', poster: '/assets/reel-3-poster.webp', alt: 'Behind-the-scenes makeup preparation reel' },
 { title: 'A night in good company', kind: 'Celebration', src: '/reels/reel4.mp4', poster: '/assets/reel-4-poster.webp', alt: 'Friends sharing a lively evening celebration' }
];
---
<Layout title="Monumental Reels — Mobile photography & films in Lagos" description="Lilly Oluwatomi Oluyemi makes thoughtful mobile photography, short films and social-ready reels in Lagos. Explore her work and share your shoot idea." active="Home" preloadImage="/assets/reel-1-poster.webp">
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero-copy"><h1 id="home-title">A day you can<br />come back <i>to.</i></h1><p class="home-hero-story">The breath before the doors open. Your auntie laughing too loudly. The way the whole room changes when the music starts. Lilly catches the moments that make a day yours—and turns them into photographs and films you can return to.</p><div class="home-hero-actions"><a class="button-primary" href="/about/#booking">Tell Lilly what you’re planning <Icon name="ph:arrow-up-right" size={16} /></a><a class="home-work-link" href="/work/">See the stories <Icon name="ph:arrow-up-right" size={14} /></a></div><p class="home-hero-byline">Made with care by <strong>Lilly Oluwatomi Oluyemi</strong></p></div>
  <div class="home-collage" aria-label="Lilly’s photographs and wedding films">
    <figure class="feature-reel"><video data-autoplay-reel muted loop controls preload="none" playsinline poster="/assets/reel-1-poster.webp" aria-label="Portrait-format wedding highlight reel by Lilly"><source src="/reels/reel1.mp4" type="video/mp4" /></video><figcaption><span class="play-mark"><Icon name="ph:play-fill" size={12} /></span><span>THE WEDDING STORY<small>Shot on mobile in Lagos</small></span></figcaption></figure>
    <figure class="float-frame float-frame-one"><Photo src="/pictures/work6.webp" alt="Portrait in a red gele and white blouse" sizes="(max-width: 650px) 26vw, 18vw" loading="eager" /><figcaption>COLOUR & CHARACTER</figcaption></figure>
    <figure class="float-frame float-frame-two"><Photo src="/pictures/work2.webp" alt="Smiling woman in a mint green traditional outfit" sizes="(max-width: 650px) 26vw, 18vw" loading="eager" /><figcaption>THE JOY BETWEEN</figcaption></figure>
    <figure class="float-frame float-frame-three"><Photo src="/pictures/work5.webp" alt="Portrait in a green and black traditional outfit" sizes="(max-width: 650px) 26vw, 18vw" loading="eager" /><figcaption>EVERY DETAIL, KEPT</figcaption></figure>
    <figure class="float-frame float-frame-four"><Photo src="/pictures/work4.webp" alt="Portrait in a red traditional outfit" sizes="(max-width: 650px) 26vw, 18vw" loading="eager" /><figcaption>MADE TO FEEL LIKE YOU</figcaption></figure>
    <span class="collage-note">REAL PEOPLE<br /><i>REAL FEELING</i></span>
  </div>
  <a class="scroll-invitation" href="#offer-title"><span class="scroll-line"></span><span>Stay for the little things<br /><small>Scroll into Lilly’s stories</small></span><Icon name="ph:arrow-down" size={15} /></a>
</section>
<section class="intro-band"><p>FOR PEOPLE WITH SOMETHING<br class="desktop" /> BEAUTIFUL TO REMEMBER</p><div class="intro-line"></div><span>Couples · Creators · Good people</span></section>
<section class="offer-section section-pad" aria-labelledby="offer-title"><div class="offer-heading reveal"><p class="eyebrow">THOUGHTFUL WORK, MADE TO BE KEPT</p><h2 id="offer-title">From the moment<br />to the <i>afterglow.</i></h2><p>One idea can become a set of photographs, a short film, and something you’re proud to share. Start with the story; Lilly will help shape the format around it.</p></div><div class="offer-list"><article class="reveal"><span class="offer-number">01</span><div><h3>Photographs with presence</h3><p>Portraits and event moments, made with an eye for the people and details that make the day yours.</p></div><Icon name="ph:aperture" size={23} /></article><article class="reveal"><span class="offer-number">02</span><div><h3>Short films that feel close</h3><p>Mobile-shot video that keeps the movement, voices and atmosphere of a moment in view.</p></div><Icon name="ph:film-strip" size={23} /></article><article class="reveal"><span class="offer-number">03</span><div><h3>Reels ready to share</h3><p>Edited short-form stories for couples, creators and brands—with the people in the frame at the centre.</p></div><Icon name="ph:device-mobile-camera" size={23} /></article><a class="offer-link reveal" href="/about/#booking">Explore an idea with Lilly <Icon name="ph:arrow-up-right" size={14} /></a></div></section>
<section class="work-section section-pad" id="selected-work"><div class="section-heading reveal"><div><p class="eyebrow">A GLIMPSE OF LILLY’S WORK</p><h2>Your story, in <i>good light.</i></h2></div><a class="text-link" href="/work/">Explore all work <Icon name="ph:arrow-up-right" size={14} /></a></div><div class="work-grid">{works.map((work, i) => <a class:list={['work-card','reveal',`work-${i+1}`]} href="/work/"><div class="work-image"><Photo src={work.image} alt={work.alt} /><span class="image-arrow"><Icon name="ph:arrow-up-right" size={17} /></span></div><div class="work-meta"><div><h3>{work.title}</h3><p>{work.kind}</p></div><span>0{i+1}</span></div></a>)}</div><p class="work-note">A small selection of photographs and stories Lilly has made. More work is being added.</p></section>
<section class="reel-shelf" aria-labelledby="reel-shelf-title"><div class="reel-shelf-head"><div><p class="eyebrow">SHORT FILMS, ON REPEAT</p><h2 id="reel-shelf-title">Little moments,<br /><i>in motion.</i></h2></div><div class="reel-shelf-actions"><span class="reel-position" aria-live="polite">01 <i>/</i> 04</span><button class="reel-arrow" type="button" data-reel-prev aria-label="Show previous reel" disabled><Icon name="ph:arrow-left" size={18} /></button><button class="reel-arrow" type="button" data-reel-next aria-label="Show next reel"><Icon name="ph:arrow-right" size={18} /></button></div></div><p class="reel-shelf-intro">Swipe through the short films, or use the arrows to browse Lilly’s recent stories.</p><div class="reel-track" data-reel-track tabindex="0" aria-label="Short reels by Lilly">{reels.map((reel, i)=><div class="reel-slide" role="group" aria-roledescription="slide" aria-label={`${i+1} of ${reels.length}`}><video data-autoplay-reel muted loop controls preload="none" playsinline poster={reel.poster} aria-label={reel.alt}><source src={reel.src} type="video/mp4" /></video><div class="reel-slide-copy"><p>{reel.kind}</p><h3>{reel.title}</h3></div></div>)}</div><a class="reel-all-link" href="/work/">Explore photography & all reels <Icon name="ph:arrow-up-right" size={14} /></a></section>
<section class="manifesto section-pad"><div class="manifesto-image reveal"><Photo src="/assets/lily6.webp" alt="Lilly outdoors, photographed in black and white" /></div><div class="manifesto-copy reveal"><p class="eyebrow">A LITTLE MORE THAN CONTENT</p><h2>Not only how it looked.<br />The way it <i>felt.</i></h2><p>Somewhere between the big moment and the tiny in-between, there’s a version of your story that feels like you. I’m here to find it, frame by frame, with the phone that’s already part of your everyday.</p><a class="text-link" href="/about/">Meet Lilly <Icon name="ph:arrow-up-right" size={14} /></a></div></section>
<section class="cta-section"><div class="cta-orbit"></div><p class="eyebrow">A GOOD PLACE TO BEGIN</p><h2>Let’s make room<br /><i>for the real thing.</i></h2><p>Share your date, where it’s happening and what you’re hoping to remember. Lilly will take it from there with you.</p><a class="button-light" href="/about/#booking">Start an enquiry <Icon name="ph:arrow-up-right" size={17} /></a><span class="cta-footnote"><Icon name="ph:map-pin" size={14} /> Lagos-based · your message opens in an app you choose</span><a class="cta-secondary" href="/about/">See how it works <Icon name="ph:arrow-right" size={14} /></a></section>
</Layout>
<style>
.offer-section{position:relative;isolation:isolate;overflow:clip;display:grid;grid-template-columns:1fr .94fr;gap:clamp(45px,6vw,86px);align-items:start;padding:clamp(70px,9vw,120px) clamp(1.2rem,8vw,8rem);background:var(--warm);scroll-margin-top:82px}.offer-section::before{position:absolute;z-index:-1;inset:0 0 auto;height:2px;background:var(--wine);content:"";opacity:.7;transform:scaleX(var(--offer-progress,0));transform-origin:left center}
.offer-heading{position:sticky;top:110px}.offer-heading h2{max-width:none;margin:15px 0 22px;font:600 clamp(3.4rem,5vw,4.6rem)/.99 var(--display);letter-spacing:-.075em;scroll-margin-top:110px}.offer-heading h2 i{color:var(--wine-2);font-weight:500}.offer-heading>p:last-child{max-width:370px;color:var(--muted);font-size:13px;line-height:1.85}
.offer-list{border-top:1px solid var(--line)}.offer-list article{display:grid;grid-template-columns:40px 1fr 28px;align-items:start;gap:15px;padding:25px 0;border-bottom:1px solid var(--line);transition:padding .24s ease,background-color .24s ease}.offer-number{padding-top:4px;color:var(--wine);font-size:9px;letter-spacing:.1em}.offer-list h3{margin:0 0 8px;font:600 21px/1.15 var(--display);letter-spacing:-.025em}.offer-list article p{max-width:460px;margin:0;color:var(--muted);font-size:12px;line-height:1.75}.offer-list article>svg{margin-top:2px;color:var(--wine);transition:transform .24s ease}.offer-link{display:flex;align-items:center;gap:8px;width:max-content;max-width:100%;margin-top:20px;padding:10px 0;border-bottom:1px solid var(--line);font-size:11px;font-weight:600}.offer-link svg{color:var(--wine);transition:transform .24s ease}.offer-link:hover svg{transform:translate(3px,-3px)}@media(hover:hover){.offer-list article:hover{padding-left:10px;background:color-mix(in srgb,var(--surface) 35%,transparent)}.offer-list article:hover>svg{transform:rotate(-8deg) scale(1.08)}}
.cta-section>p:not(.eyebrow){max-width:490px;margin:0 auto 27px;line-height:1.8}.cta-secondary{display:flex;align-items:center;justify-content:center;gap:7px;width:max-content;margin:22px auto 0;color:inherit;font-size:11px;opacity:.85}.cta-footnote{display:flex;justify-content:center;align-items:center;gap:6px;margin-top:22px;font-size:10px;opacity:.8}
:global(html[data-theme='dark']) .cta-section .eyebrow{color:#f0c6c5}
:global(html[data-theme='dark']) .cta-section>p:not(.eyebrow){color:var(--muted)}
@media(max-width:700px){.offer-section{grid-template-columns:1fr;gap:27px;padding:68px 1.2rem}.offer-heading{position:static}.offer-heading h2{font-size:3rem}.offer-list article{grid-template-columns:30px 1fr 24px;gap:10px;padding:21px 0}.offer-list h3{font-size:19px}.offer-list article p{font-size:11px}.cta-section>p:not(.eyebrow){max-width:390px}.cta-footnote{font-size:9px}.cta-secondary{margin-top:19px}}
@media(prefers-reduced-motion:reduce){.offer-heading{scroll-behavior:auto}}
</style>

<style>
.intro-band{display:flex;align-items:center;justify-content:center;gap:34px;padding:24px 1rem;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:color-mix(in srgb,var(--surface) 60%,transparent);text-align:center}.intro-band p{margin:0;color:var(--wine);font-size:10px;font-weight:600;line-height:1.5}.intro-band span{color:var(--muted);font-size:12px}.intro-line{width:46px;height:1px;background:var(--line)}
.work-section{padding:clamp(70px,9vw,120px) clamp(1.2rem,8vw,8rem)}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:36px}.section-heading h2,.manifesto-copy h2{margin:12px 0 0;font:600 clamp(2.8rem,5.8vw,5.4rem)/.98 var(--display);letter-spacing:-.075em}.section-heading h2 i,.manifesto-copy h2 i{color:var(--wine-2);font-style:italic}.eyebrow{margin:0;color:var(--wine);font-size:10px;font-weight:600;letter-spacing:.12em}.text-link{display:inline-flex;align-items:center;gap:7px;padding:9px 0;border-bottom:1px solid var(--line);font-size:12px;font-weight:600}.text-link svg{color:var(--wine)}.work-grid{display:grid;grid-template-columns:1fr .82fr 1fr;gap:25px;align-items:start}.work-2{margin-top:66px}.work-image{height:clamp(280px,31vw,400px);position:relative;overflow:hidden;border:1px solid var(--glass-border);border-radius:16px;background:var(--warm);box-shadow:var(--shadow)}.work-2 .work-image{height:clamp(250px,27vw,340px)}.work-3 .work-image{height:clamp(300px,34vw,420px)}.work-image :global(img){width:100%;height:100%;object-fit:cover;transition:transform .6s cubic-bezier(.2,0,0,1)}.work-card:hover .work-image :global(img){transform:scale(1.04)}.image-arrow{position:absolute;right:13px;top:13px;display:grid;place-items:center;width:38px;height:38px;border:1px solid var(--glass-border);border-radius:50%;color:var(--wine);background:var(--glass-strong);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}.work-meta{display:flex;justify-content:space-between;align-items:start;padding-top:14px}.work-meta h3{margin:0 0 5px;font:600 21px var(--display)}.work-meta p{margin:0;color:var(--muted);font-size:11px}.work-meta>span{color:var(--wine);font-size:10px}.work-note{margin:25px 0 0;color:var(--muted);font-size:11px}
.reel-shelf{padding:clamp(70px,9vw,110px) clamp(1.2rem,7vw,7rem);background:var(--warm)}.reel-shelf-head{display:flex;align-items:end;justify-content:space-between;gap:25px;max-width:1300px;margin:auto}.reel-shelf-head h2{margin:13px 0 0;font:600 clamp(2.8rem,6vw,5.2rem)/.94 var(--display);letter-spacing:-.08em}.reel-shelf-head h2 i{color:var(--wine-2);font-style:italic}.reel-shelf-actions{display:flex;align-items:center;gap:8px}.reel-position{margin-right:8px;color:var(--muted);font-size:12px}.reel-position i{color:var(--wine);font-style:normal}.reel-arrow{display:grid;place-items:center;width:42px;height:42px;border:1px solid var(--line);border-radius:50%;color:var(--ink);background:var(--glass);cursor:pointer}.reel-arrow:disabled{opacity:.4}.reel-shelf-intro{max-width:1300px;margin:20px auto;color:var(--muted);font-size:12px;line-height:1.7}.reel-track{display:flex;gap:17px;max-width:1300px;margin:auto;padding:4px 0 14px;overflow-x:auto;overscroll-behavior-x:contain;scroll-snap-type:x mandatory;scrollbar-width:none}.reel-track::-webkit-scrollbar{display:none}.reel-slide{flex:0 0 clamp(230px,24vw,310px);scroll-snap-align:start}.reel-slide video{display:block;width:100%;aspect-ratio:9/12;object-fit:cover;border:1px solid var(--glass-border);border-radius:17px;background:#21191d;box-shadow:var(--shadow)}.reel-slide-copy{display:flex;align-items:baseline;justify-content:space-between;gap:10px;padding:12px 2px}.reel-slide-copy p{margin:0;color:var(--wine);font-size:9px}.reel-slide-copy h3{margin:0;font:600 18px var(--display)}.reel-all-link{display:flex;align-items:center;gap:7px;width:max-content;margin:22px auto 0;padding-bottom:5px;border-bottom:1px solid var(--line);font-size:11px;font-weight:600}
.manifesto{display:grid;grid-template-columns:.85fr 1fr;gap:clamp(45px,9vw,130px);align-items:center;padding:clamp(70px,9vw,120px) clamp(1.2rem,8vw,8rem);background:var(--paper)}.manifesto-image{width:min(100%,410px);height:440px;justify-self:center;padding:10px;border:1px solid var(--glass-border);border-radius:6px;background:var(--glass-strong);box-shadow:var(--shadow);transform:rotate(-2deg)}.manifesto-image :global(img){display:block;width:100%;height:100%;object-fit:cover}.manifesto-copy>p:not(.eyebrow){max-width:470px;margin:23px 0;color:var(--muted);font-size:14px;line-height:1.9}
.cta-section{position:relative;overflow:hidden;padding:clamp(75px,9vw,112px) 1.2rem;text-align:center;background:var(--wine);color:var(--on-action)}.cta-section .eyebrow{color:color-mix(in srgb,var(--on-action) 72%,var(--wine))}.cta-section h2{margin:18px 0;font:600 clamp(3.4rem,7vw,6.5rem)/.96 var(--display);letter-spacing:-.08em}.cta-section h2 i{color:#f0c6c5;font-style:italic}.cta-section>p:not(.eyebrow){max-width:490px;margin:0 auto 27px;line-height:1.8;color:color-mix(in srgb,var(--on-action) 80%,transparent)}.button-light{display:inline-flex;align-items:center;gap:14px;padding:15px 21px;border-radius:999px;background:#f4e9de;color:#412720;font-size:12px;font-weight:700;box-shadow:0 9px 25px rgb(25 11 17 / 18%)}.cta-footnote{display:flex;justify-content:center;align-items:center;gap:6px;margin-top:21px;font-size:10px;opacity:.85}.cta-secondary{display:flex;align-items:center;justify-content:center;gap:7px;width:max-content;margin:20px auto 0;color:inherit;font-size:11px}
@media(max-width:760px){.intro-band{flex-wrap:wrap;gap:10px 15px;padding:18px 1rem}.intro-line{width:28px}.intro-band p{font-size:8px}.intro-band span{font-size:10px}.work-section{padding:68px 1.2rem}.section-heading{align-items:start;flex-direction:column;gap:14px}.section-heading h2,.manifesto-copy h2{font-size:2.9rem}.work-grid{grid-template-columns:1fr;gap:26px}.work-2{margin:0}.work-image,.work-2 .work-image,.work-3 .work-image{height:390px}.reel-shelf{padding:67px 1.2rem 76px}.reel-shelf-head{align-items:start;flex-direction:column;gap:17px}.reel-shelf-head h2{font-size:3rem}.reel-slide{flex-basis:72vw}.manifesto{grid-template-columns:1fr;gap:35px;padding:68px 1.2rem}.manifesto-image{width:82%;height:380px}.cta-section{padding:76px 1.2rem 83px}.cta-section h2{font-size:clamp(3.2rem,14vw,4.6rem)}}@media(max-width:420px){.work-image,.work-2 .work-image,.work-3 .work-image{height:330px}}@media(prefers-reduced-motion:reduce){.work-image :global(img){transition:none}}
</style>

<style>
.home-hero{position:relative;max-width:1560px;min-height:min(810px,calc(100svh - 90px));margin:auto;padding:clamp(40px,5vw,68px) clamp(1.2rem,7vw,7rem) 72px;display:grid;grid-template-columns:minmax(320px,.9fr) minmax(0,1.1fr);gap:clamp(26px,4vw,64px);align-items:center;overflow:hidden}.home-hero-copy{position:relative;z-index:2;max-width:560px}.home-hero-copy h1{max-width:11ch;margin:0 0 22px;font:600 clamp(3.8rem,6.3vw,6.5rem)/.88 var(--display);letter-spacing:-.082em}.home-hero-copy h1 i{color:var(--wine-2);font-style:italic}.home-hero-story{max-width:450px;margin:0;color:var(--muted);font-size:15px;line-height:1.82}.home-hero-actions{display:flex;align-items:center;flex-wrap:wrap;gap:19px;margin-top:29px}.home-hero-actions .button-primary{padding:15px 20px;border-radius:999px}.home-work-link{display:flex;align-items:center;gap:6px;padding:8px 0;border-bottom:1px solid var(--line);font-size:12px;font-weight:600}.home-work-link svg{color:var(--wine)}.home-hero-byline{margin:34px 0 0;padding-top:13px;border-top:1px solid var(--line);color:var(--muted);font:500 14px var(--display)}.home-hero-byline strong{color:var(--ink);font-weight:600}.home-collage{position:relative;min-width:0;width:100%;max-width:700px;overflow:hidden;margin-inline:auto;height:clamp(470px,48vw,640px);isolation:isolate}.feature-reel{position:absolute;z-index:1;left:25%;top:5%;width:min(42%,310px);height:auto;aspect-ratio:9/16;margin:0;overflow:hidden;border:6px solid var(--glass-strong);border-radius:28px;background:#21191d;box-shadow:0 35px 90px color-mix(in srgb,var(--ink) 24%,transparent),inset 0 0 0 1px var(--glass-border)}.feature-reel video{display:block;width:100%;height:100%;aspect-ratio:9/16;object-fit:cover;object-position:center 38%;border-radius:21px;background:#21191d;filter:none!important;transform:none!important}.feature-reel figcaption{position:absolute;left:10px;right:10px;bottom:10px;display:flex;align-items:center;gap:8px;padding:8px 9px;border:1px solid rgb(255 255 255 / 40%)