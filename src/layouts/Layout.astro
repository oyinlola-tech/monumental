---
import { Icon } from 'astro-icon/components';
const { title = 'Monumental Reels — Lilly Oluwatomi Oluyemi', description = 'Mobile photography, films and social content by Lilly Oluwatomi Oluyemi in Lagos, Nigeria.', active = 'Home', preloadImage } = Astro.props;
const nav = [{ label: 'Home', href: '/' }, { label: 'Selected work', href: '/work/' }, { label: 'About & book', href: '/about/' }];
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f2ec" /><meta name="description" content={description} />
    <meta name="author" content="Lilly Oluwatomi Oluyemi" /><meta property="og:type" content="website" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:locale" content="en_NG" /><meta name="color-scheme" content="light dark" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    <link rel="icon" type="image/png" href="/assets/monumental-reels-favicon.png" /><link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" /><noscript><link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');try{const saved=localStorage.getItem('mr-theme');document.documentElement.dataset.theme=saved||'light'}catch{document.documentElement.dataset.theme='light'}</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Monumental Reels home"><img class="brand-logo brand-logo-light" src="/assets/monumental-reels-logo-light.webp" alt="" width="500" height="119" loading="eager" decoding="async" /><img class="brand-logo brand-logo-dark" src="/assets/monumental-reels-logo-dark.webp" alt="" width="500" height="119" loading="eager" decoding="async" /></a>
      <nav class="desktop-nav" aria-label="Main navigation">{nav.map((item) => <a class:list={['desktop-nav-link', { active: active === item.label }]} href={item.href} aria-current={active === item.label ? 'page' : undefined}>{item.label}</a>)}</nav>
      <div class="header-actions">
        <button class="nav-trigger" type="button" aria-expanded="false" aria-controls="site-navigation"><span>Menu</span><span class="menu-glyph" aria-hidden="true"><i></i><i></i></span></button>
        <button class="theme-toggle" type="button" aria-label="Switch colour theme" title="Switch colour theme" aria-pressed="false"><Icon name="ph:sun" class="sun-icon" size={19} /><Icon name="ph:moon" class="moon-icon" size={19} /></button>
        <a class="header-cta" href="/about/#booking">Plan a shoot <Icon name="ph:arrow-up-right" size={15} /></a>
      </div>
    </header>
    <dialog class="nav-panel" id="site-navigation" aria-labelledby="navigation-title">
      <div class="panel-top"><span class="panel-brand" role="img" aria-label="Monumental Reels · Lagos"><img class="brand-logo brand-logo-light" src="/assets/monumental-reels-logo-light.webp" alt="" width="500" height="119" loading="lazy" decoding="async" /><img class="brand-logo brand-logo-dark" src="/assets/monumental-reels-logo-dark.webp" alt="" width="500" height="119" loading="lazy" decoding="async" /></span><button class="nav-close" type="button" aria-label="Close navigation"><Icon name="ph:x" size={18} /></button></div>
      <p class="panel-kicker">THE PAGE INDEX</p><h2 id="navigation-title">Find your way<br /><em>into the story.</em></h2>
      <nav aria-label="Main navigation">{nav.map((item, index) => <a class:list={['drawer-link', { active: active === item.label }]} href={item.href} aria-current={active === item.label ? 'page' : undefined}><span>0{index + 1}</span>{item.label}<Icon name="ph:arrow-up-right" size={17} /></a>)}</nav>
      <div class="panel-bottom"><span>PHOTO · FILM · CREATIVE CONTENT</span><a href="/about/#booking">Plan your shoot <Icon name="ph:arrow-up-right" size={15} /></a></div>
    </dialog>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="footer-shell">
        <div class="footer-status"><span>GOOD STORIES START WITH A HELLO</span><span class="status-divider"></span><span>LAGOS, NIGERIA</span></div>
        <div class="footer-main">
          <div class="footer-message"><p class="footer-kicker">LET’S MAKE IT FEEL LIKE YOU</p><h2>Keep what<br /><em>matters.</em></h2><p class="footer-description">The big days, the everyday magic, the ideas you can’t stop thinking about. Let’s make them something you can return to.</p></div>
        <div class="footer-invite"><span class="invite-label">FOR YOUR NEXT MOMENT</span><p>Photography, short films and social content made with care in Lagos.</p><a class="footer-cta" href="/about/#booking"><span>Tell Lilly what you have in mind</span><span class="cta-arrow"><Icon name="ph:arrow-up-right" size={19} /></span></a><span class="invite-note">A good story starts with a hello.</span><div class="footer-contact"><a href="https://wa.me/2347069974016" target="_blank" rel="noopener noreferrer"><Icon name="ph:whatsapp-logo" size={17} /> WhatsApp Lilly</a><a href="mailto:Lilyoluyemi@gmail.com"><Icon name="ph:envelope-simple" size={17} /> Email Lilly</a></div></div>
        </div>
        <div class="footer-bottom"><a class="footer-brand" href="/"><img class="brand-logo brand-logo-light" src="/assets/monumental-reels-logo-light.webp" alt="" width="500" height="119" loading="lazy" decoding="async" /><img class="brand-logo brand-logo-dark" src="/assets/monumental-reels-logo-dark.webp" alt="" width="500" height="119" loading="lazy" decoding="async" /><span>By Lilly Oluwatomi Oluyemi</span></a><nav class="footer-links" aria-label="Footer navigation"><a href="/work/">Selected work <Icon name="ph:arrow-up-right" size={12} /></a><a href="/about/">Meet Lilly <Icon name="ph:arrow-up-right" size={12} /></a><a href="/about/#booking">Start an enquiry <Icon name="ph:arrow-up-right" size={12} /></a></nav><nav class="footer-socials" aria-label="Lilly’s social media"><a href="https://www.instagram.com/monumental__reels" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><Icon name="ph:instagram-logo" size={17} /></a><a href="https://www.tiktok.com/@monumental_reels" target="_blank" rel="noopener noreferrer" aria-label="TikTok"><Icon name="ph:tiktok-logo" size={17} /></a></nav><small>© {new Date().getFullYear()} Monumental Reels<br />Made with care in Lagos</small></div>
        <a class="footer-wordmark" href="/" aria-label="Monumental Reels home">MONUMENTAL REELS</a>
      </div>
    </footer>
  </body>
</html>
<style is:global>
:root {
  font-family: 'DM Sans', sans-serif;
  color-scheme: light;
  --paper: #f7f2ec;
  --surface: #fffdf9;
  --ink: #302027;
  --muted: #705d64;
  --line: #e0d1d4;
  --wine: #71344c;
  --wine-2: #8e5263;
  --action: #71344c;
  --on-action: #fffaf8;
  --warm: #ede1de;
  --accent: #a16c4d;
  --footer-bg: #34232b;
  --footer-surface: #46313a;
  --footer-ink: #fbf3f0;
  --footer-muted: #dfc9ca;
  --footer-accent: #e6b9b4;
  --footer-border: #71565f;
  --footer-button: #fff0e7;
  --footer-button-ink: #34232b;
  --shadow: 0 24px 64px #33201921;
  --glass: rgb(255 251 245 / 78%);
  --glass-strong: rgb(255 251 245 / 96%);
  --glass-border: rgb(255 255 255 / 72%);
  --glass-shadow: 0 18px 55px rgb(51 32 25 / 17%);
  --display: 'Cormorant Garamond', serif;
}
html[data-theme='dark'] {
  color-scheme: dark;
  --paper: #19151b;
  --surface: #262029;
  --ink: #f6ece9;
  --muted: #cbbbc0;
  --line: #493d48;
  --wine: #de9aaf;
  --wine-2: #e9b5bd;
  --action: #dda1b0;
  --on-action: #29181e;
  --warm: #342730;
  --accent: #ddb48d;
  --footer-bg: #120f15;
  --footer-surface: #251c27;
  --footer-ink: #f6ece9;
  --footer-muted: #cbbbc0;
  --footer-accent: #e7b1bf;
  --footer-border: #493d48;
  --footer-button: #f1e3dc;
  --footer-button-ink: #25181f;
  --shadow: 0 24px 64px #09060670;
  --glass: rgb(42 32 32 / 78%);
  --glass-strong: rgb(42 32 32 / 96%);
  --glass-border: rgb(255 255 255 / 11%);
  --glass-shadow: 0 18px 55px rgb(0 0 0 / 34%);
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--paper); color: var(--ink); transition: background .3s, color .3s; }
body.nav-open { overflow: hidden; }
a { color: inherit; text-decoration: none; }
button { font: inherit; }
.skip-link { position: absolute; top: -100px; left: 1rem; z-index: 100; background: var(--action); color: var(--on-action); padding: .8rem; }
.skip-link:focus { top: 1rem; }
.site-header {
  position: sticky; top: 0; z-index: 20; height: 82px;
  display: grid; grid-template-columns: 1fr auto; align-items: center;
  padding: 0 clamp(1.2rem, 5vw, 5rem);
  background: var(--glass);
  -webkit-backdrop-filter: saturate(150%) blur(20px);
  backdrop-filter: saturate(150%) blur(20px);
  border-bottom: 1px solid color-mix(in srgb, var(--line) 62%, transparent);
  box-shadow: 0 5px 24px rgb(46 29 24 / 5%);
}
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .site-header { background: var(--paper); }
}
.wordmark { display: block; width: 162px; line-height: 0; }
.brand-logo { display: block; width: 100%; height: auto; }
.brand-logo-dark { display: none; }
html[data-theme='dark'] .brand-logo-light { display: none; }
html[data-theme='dark'] .brand-logo-dark { display: block; }
.header-actions { display: flex; justify-content: flex-end; align-items: center; gap: 12px; }
.nav-trigger {
  position: relative; z-index: 23;
  display: flex; align-items: center; gap: 13px;
  padding: 11px 14px; border: 1px solid color-mix(in srgb, var(--line) 80%, transparent);
  border-radius: 999px; background: var(--glass-strong); color: var(--ink);
  font-size: 12px; cursor: pointer;
  box-shadow: inset 0 1px 0 var(--glass-border), 0 5px 14px rgb(40 24 20 / 7%);
  -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  transition: transform .16s cubic-bezier(.2, 0, 0, 1), background .18s, box-shadow .18s;
}
.nav-trigger[aria-expanded='true'] { visibility: hidden; }
.nav-trigger:active, .theme-toggle:active, .nav-close:active,
.header-cta:active, .footer-cta:active, .button-primary:active, .button-light:active { transform: scale(.97); }
.menu-glyph { display: grid; width: 17px; gap: 5px; }
.menu-glyph i { height: 1px; background: currentColor; transition: transform .22s, width .22s; }
.menu-glyph i:last-child { width: 11px; justify-self: end; }
.nav-panel {
  position: fixed; inset: 0 0 0 auto; z-index: 22; width: min(460px, 100vw); max-width: none; height: 100dvh; max-height: none; margin: 0 0 0 auto;
  padding: 28px clamp(24px, 5vw, 48px) 34px; display: flex; flex-direction: column;
  background: var(--surface); -webkit-backdrop-filter: saturate(145%) blur(26px); backdrop-filter: saturate(145%) blur(26px);
  border: 0; border-left: 1px solid var(--glass-border); color: var(--ink);
  box-shadow: -20px 0 70px #13090735, inset 1px 0 0 var(--glass-border);
  animation: drawer-in .32s cubic-bezier(.2, 0, 0, 1) both;
}
.nav-panel[open] { display: flex; }
.nav-panel:not([open]) { display: none; }
.nav-panel::backdrop { background: rgb(23 14 13 / 48%); -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); animation: scrim-in .22s ease forwards; }
.nav-panel > * { position: relative; z-index: 1; }
.panel-top { display: flex; align-items: center; justify-content: space-between; padding-bottom: 18px; border-bottom: 1px solid var(--line); color: var(--muted); font-size: 9px; letter-spacing: .14em; }
.panel-brand { display: block; width: 160px; }
.nav-close { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 50%; background: var(--glass); color: var(--ink); cursor: pointer; transition: transform .16s, background .18s; }
.panel-kicker { margin: 52px 0 0; color: var(--wine); font-size: 9px; font-weight: 700; letter-spacing: .18em; }
.nav-panel h2 { margin: 17px 0 32px; font: 600 clamp(2.8rem, 6vw, 4.5rem)/.98 var(--display); letter-spacing: -.065em; }
.nav-panel h2 em { color: var(--wine-2); font-style: normal; }
.nav-panel nav { display: grid; }
.drawer-link { display: grid; grid-template-columns: 38px 1fr auto; align-items: center; gap: 12px; padding: 17px 0; border-top: 1px solid var(--line); font: 500 22px var(--display); transition: color .18s, padding .18s; }
.drawer-link:last-child { border-bottom: 1px solid var(--line); }
.drawer-link > span { color: var(--muted); font: 500 9px 'DM Sans', sans-serif; }
.drawer-link svg { color: var(--wine); transition: transform .18s; }
.drawer-link:hover, .drawer-link.active { color: var(--wine); }
.drawer-link:hover { padding-left: 6px; }
.drawer-link:hover svg { transform: translate(2px, -2px); }
.panel-bottom { display: grid; gap: 17px; margin-top: auto; padding-top: 22px; border-top: 1px solid var(--line); }
.panel-bottom > span { color: var(--muted); font-size: 9px; letter-spacing: .14em; }
.panel-bottom > a { display: flex; align-items: center; justify-content: space-between; padding: 14px 17px; border-radius: 14px; background: var(--action); color: var(--on-action); font-size: 12px; font-weight: 600; transition: transform .18s, background .18s; }
.panel-bottom > a:hover { background: var(--wine-2); transform: translateY(-1px); }
.nav-trigger:focus-visible, .nav-close:focus-visible, .drawer-link:focus-visible, .panel-bottom > a:focus-visible,
.site-header a:focus-visible, .site-footer a:focus-visible, .theme-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
@keyframes drawer-in { from { transform: translateX(32px); opacity: .92; } to { transform: translateX(0); opacity: 1; } }
@keyframes scrim-in { to { opacity: 1; } }
.theme-toggle { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; border: 1px solid color-mix(in srgb, var(--line) 85%, transparent); border-radius: 50%; background: var(--glass); color: var(--ink); cursor: pointer; box-shadow: inset 0 1px 0 var(--glass-border), 0 5px 14px rgb(40 24 20 / 6%); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); transition: transform .16s cubic-bezier(.2, 0, 0, 1), background .2s, border-color .2s; }
.theme-toggle .moon-icon { display: none; }
html[data-theme='dark'] .theme-toggle .moon-icon { display: inline; }
html[data-theme='dark'] .theme-toggle .sun-icon { display: none; }
.header-cta, .footer-cta { display: inline-flex; align-items: center; gap: 15px; padding: 13px 17px; border-radius: 999px; background: var(--action); color: var(--on-action); font-size: 12px; font-weight: 600; box-shadow: 0 6px 16px color-mix(in srgb, var(--wine) 18%, transparent); transition: background .2s, transform .2s; }
.button-primary, .button-light { border-radius: 999px; box-shadow: 0 8px 22px color-mix(in srgb, var(--wine) 20%, transparent); transition: transform .18s cubic-bezier(.2, 0, 0, 1), background .18s, color .18s, box-shadow .18s; }
.header-cta:hover { background: var(--wine-2); color: var(--on-action); }
html[data-theme='dark'] .header-cta:hover { color: #251a19; }
.footer-cta:hover { background: white; }
.header-cta:hover, .footer-cta:hover { transform: translateY(-2px); }
@media (prefers-reduced-motion: reduce) { .nav-panel, .nav-panel::backdrop, .menu-glyph i, .drawer-link, .drawer-link svg { animation: none !important; transition: none !important; } }
@media (max-width: 760px) {
  .site-header { height: auto; min-height: 70px; padding: 10px 1rem; }
  .wordmark { width: 146px; }
  .header-cta { display: none; }
  .header-actions { gap: 9px; }
  .theme-toggle, .nav-trigger { min-width: 42px; min-height: 42px; }
  .nav-panel { padding-top: max(20px, env(safe-area-inset-top)); padding-bottom: max(24px, env(safe-area-inset-bottom)); }
  .nav-panel h2 { margin-top: 15px; margin-bottom: 25px; }
  .panel-kicker { margin-top: 35px; }
}
.site-footer{background:#382321;color:#faf2e9;padding:32px clamp(1.2rem,7vw,7rem) 18px;overflow:hidden}.footer-shell{max-width:1440px;margin:0 auto}.footer-status{display:flex;align-items:center;gap:10px;color:#e2b8a4;font-size:9px;font-weight:600;letter-spacing:.16em}.status-dot{width:7px;height:7px;border-radius:50%;background:#d9a77d;box-shadow:0 0 0 4px #d9a77d20}.status-divider{height:1px;width:28px;background:#79584e;margin:0 4px}.footer-main{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(36px,8vw,120px);align-items:stretch;padding:58px 0 62px}.footer-message{max-width:720px}.footer-kicker{font-size:10px;letter-spacing:.16em;color:#e2b8a4;margin:0}.footer-message h2{font:600 clamp(4rem,9vw,8.8rem)/.82 var(--display);letter-spacing:-.075em;margin:23px 0 24px}.footer-message h2 em{font-style:normal;color:#e4b1a8}.footer-description{max-width:390px;color:#ddc9bd;font-size:13px;line-height:1.8;margin:0}.footer-invite{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;background:#49302e;padding:clamp(24px,4vw,50px);min-height:270px}.invite-label{font-size:9px;letter-spacing:.16em;color:#e7b6aa}.footer-invite>p{font:500 clamp(1.6rem,3vw,2.35rem)/1.22 var(--display);max-width:390px;margin:19px 0 30px}.footer-cta{display:flex;align-items:center;justify-content:space-between;gap:24px;width:100%;padding:9px 10px 9px 17px;background:#f5e9dc;color:#382321;font-size:12px;font-weight:600;transition:transform .2s,background .2s}.cta-arrow{display:grid;place-items:center;width:40px;height:40px;background:#713449;color:#fff;border-radius:50%;transition:transform .2s}.footer-cta:hover{background:white;transform:translateY(-2px)}.footer-cta:hover .cta-arrow{transform:rotate(45deg)}html[data-theme=dark] .footer-cta:hover{color:#382321}.invite-note{margin-top:15px;color:#cdb4a7;font-size:10px}.footer-bottom{display:grid;grid-template-columns:1fr auto auto;align-items:start;gap:35px;padding:22px 0;border-top:1px solid #79584e;color:#ddc9bd;font-size:11px}.footer-brand{display:grid;justify-items:start;gap:9px;color:#fff5eb}.footer-brand .brand-logo{width:134px}.footer-brand span{display:block;font:400 10px 'DM Sans',sans-serif;letter-spacing:0;color:#ddc9bd}.footer-links{display:grid;gap:11px}.footer-links a{display:flex;align-items:center;min-height:24px;gap:7px;color:#ddc9bd;transition:color .18s}.footer-links a svg{color:#e2b8a4}.footer-links a:hover{color:white}.footer-bottom small{font-size:10px;line-height:1.7;text-align:right;white-space:nowrap}.footer-wordmark{display:block;width:max-content;max-width:100%;margin:58px auto 0;font:600 clamp(2rem,8.1vw,8rem)/.9 var(--display);letter-spacing:-.085em;white-space:nowrap;color:#e4b1a8;text-align:center;transition:color .2s}.footer-wordmark:hover{color:#f5e9dc}
@media(max-width:760px){.site-header{height:auto;min-height:72px;grid-template-columns:1fr auto;padding:10px 1rem}.header-cta{display:none}.footer-main{grid-template-columns:1fr;gap:30px;padding:45px 0}.footer-message h2{font-size:clamp(4.2rem,16vw,6.3rem)}.footer-invite{min-height:240px}.footer-bottom{grid-template-columns:1fr;gap:22px}.footer-bottom small{text-align:left}.footer-wordmark{font-size:clamp(2rem,8.1vw,4rem);margin-top:42px}}
/* Soft translucent surfaces, clear contrast, and tactile feedback across the site. */
.footer-invite{position:relative;overflow:hidden;border:1px solid rgb(255 255 255 / 10%);border-radius:22px;background:linear-gradient(145deg,rgb(255 255 255 / 9%),transparent 62%),#49302e;box-shadow:inset 0 1px 0 rgb(255 255 255 / 13%),0 22px 50px rgb(10 6 6 / 20%)}.footer-invite::after{content:"";position:absolute;width:210px;height:210px;border:1px solid rgb(255 255 255 / 10%);border-radius:50%;right:-95px;top:-125px;pointer-events:none}.footer-cta{border-radius:14px}.footer-wordmark:hover{transform:translateY(-2px)}.nav-panel>*{position:relative;z-index:1}
@media(hover:hover){.story-image:hover img,.work-image:hover img{transform:scale(1.04)}.work-card:hover .image-arrow{transform:translateY(-2px);box-shadow:0 8px 22px rgb(0 0 0 / 16%)}}
@media(hover:none){.nav-trigger:active,.theme-toggle:active,.nav-close:active,.header-cta:active,.footer-cta:active,.button-primary:active,.button-light:active,.drawer-link:active{opacity:.82}}
@media(max-width:760px){.site-header{min-height:70px}.nav-panel{padding-top:max(20px,env(safe-area-inset-top));padding-bottom:max(24px,env(safe-area-inset-bottom))}.nav-panel h2{margin-top:15px;margin-bottom:25px}.panel-kicker{margin-top:35px}.header-actions{gap:9px}.theme-toggle{width:42px;height:42px}.nav-trigger{min-height:42px}.footer-invite{border-radius:18px}}
